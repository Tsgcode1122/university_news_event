<article class="event-card">

  <div class="event-date-box">

    {% if node.field_start_date_time.value %}

      <span class="event-day">
        {{ node.field_start_date_time.value|date('d') }}
      </span>

      <span class="event-month">
        {{ node.field_start_date_time.value|date('M') }}
      </span>

    {% endif %}

  </div>


  <div class="event-card-content">

    {% if content.field_event_category %}

      <div class="event-category">
        {{ content.field_event_category }}
      </div>

    {% endif %}


    <h3 class="event-card-title">

      <a href="{{ url }}">
        {{ node.label }}
      </a>

    </h3>


    <div class="event-meta">

      {% if node.field_start_date_time.value %}

        <div class="event-time">

          <span aria-hidden="true">◷</span>

          <span>
            {{ node.field_start_date_time.value|date('g:i A') }}

            {% if node.field_end_date_time.value %}
              –
              {{ node.field_end_date_time.value|date('g:i A') }}
            {% endif %}
          </span>

        </div>

      {% endif %}


      {% if node.field_location.value %}

        <div class="event-location">

          <span aria-hidden="true">⌖</span>

          <span>
            {{ node.field_location.value }}
          </span>

        </div>

      {% endif %}

    </div>

  </div>

</article>