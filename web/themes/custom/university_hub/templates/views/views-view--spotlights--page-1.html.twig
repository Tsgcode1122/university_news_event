<div{{ attributes.addClass('news-listing', 'spotlights-listing') }}>
  {{ title_prefix }}{{ title_suffix }}
  <header class="news-listing-header">
    <p class="featured-news-kicker"><span aria-hidden="true"></span>{{ 'Spotlights'|t }}</p>
    <h1>{{ 'Community Spotlights'|t }}</h1>
    <p>{{ 'Discover the students, faculty, staff, and alumni whose ideas and achievements shape our community.'|t }}</p>
  <nav class="news-breadcrumb" aria-label="{{ 'Breadcrumb'|t }}">
    <a href="{{ path('<front>') }}">{{ 'Home'|t }}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ 'Spotlights'|t }}</span>
  </nav>
  </header>
  {% if header %}{{ header }}{% endif %}
  <div class="news-listing-filters">
    {{ exposed }}
    <a class="news-clear-filters" href="{{ path('view.spotlights.page_1') }}">{{ 'Clear filters'|t }}</a>
  </div>
  <div class="news-results-heading">
    <h2><span aria-hidden="true"></span>{{ 'Latest spotlights'|t }}</h2>
    {% set total = view.total_rows %}
    {% set first = view.pager.currentPage * view.pager.itemsPerPage + 1 %}
    {% set last = min(first + view.result|length - 1, total) %}
    <p>{% if total %}{{ 'Showing @first–@last of @total spotlights'|t({'@first': first, '@last': last, '@total': total}) }}{% else %}{{ '0 spotlights'|t }}{% endif %}</p>
  </div>
  {% if attachment_before %}{{ attachment_before }}{% endif %}
  {% if rows %}
    {{ rows }}
  {% elseif empty %}
    <div class="news-listing-empty">{{ empty }}</div>
  {% endif %}
  {{ pager }}
  {{ more }}
  {{ attachment_after }}
  {{ footer }}
</div>
